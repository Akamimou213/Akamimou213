    {
      "t0": 0.0,
      "t1": 2.3,
      "text": "Something’s felt off for months."
    },
    {
      "t0": 2.42,
      "t1": 4.25,
      "text": "Bloating. Weird bathroom days."
    },
    {
      "t0": 4.34,
      "t1": 5.02,
      "text": "At the doctor,"
    },
    {
      "t0": 5.08,
      "t1": 6.33,
      "text": "the questions come fast."
    },
    {
      "t0": 6.42,
      "t1": 7.2,
      "text": "Since when?"
    },
    {
      "t0": 7.28,
      "t1": 7.95,
      "text": "How often?"
    },
    {
      "t0": 8.02,
      "t1": 8.84,
      "text": "After what?"
    },
    {
      "t0": 8.92,
      "t1": 10.37,
      "text": "And her mind goes blank."
    },
    {
      "t0": 10.46,
      "t1": 11.42,
      "text": "Could be stress."
    },
    {
      "t0": 11.48,
      "t1": 12.63,
      "text": "Let’s keep an eye on it."
    },
    {
      "t0": 12.72,
      "t1": 14.04,
      "text": "Log it when it happens,"
    },
    {
      "t0": 14.1,
      "t1": 14.98,
      "text": "not from memory."
    },
    {
      "t0": 15.08,
      "t1": 17.6,
      "text": "Meals, sleep, stress, your cycle."
    },
    {
      "t0": 17.7,
      "t1": 18.6,
      "text": "Bring a summary,"
    },
    {
      "t0": 18.66,
      "t1": 19.75,
      "text": "not a story."
    },
    {
      "t0": 19.84,
      "t1": 20.78,
      "text": "Back at the doctor,"
    },
    {
      "t0": 20.84,
      "t1": 22.33,
      "text": "the questions have answers."
    },
    {
      "t0": 22.42,
      "t1": 23.98,
      "text": "Get Regular turns your daily logs"
